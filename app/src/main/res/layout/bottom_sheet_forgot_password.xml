<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#CBD5E1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Khôi phục mật khẩu 🔐"
            android:textAlignment="center"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Nhập email đã đăng ký để nhận mã OTP và tạo mật khẩu mới."
            android:textAlignment="center"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <!-- Email và Nút Gửi OTP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email tài khoản"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtForgotEmail"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_input"
                android:hint="Nhập email..."
                android:inputType="textEmailAddress"
                android:paddingHorizontal="14dp"
                android:textColor="#0F172A"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendForgotOtp"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#3B82F6"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Gửi mã"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Mã OTP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Mã xác thực OTP (6 số)"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtForgotOtp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_input"
            android:hint="Nhập mã 6 số từ email..."
            android:inputType="number"
            android:maxLength="6"
            android:paddingHorizontal="14dp"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <!-- Mật khẩu mới -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Mật khẩu mới"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtForgotNewPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_input"
            android:hint="Tối thiểu 6 ký tự..."
            android:inputType="textPassword"
            android:paddingHorizontal="14dp"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <!-- Xác nhận mật khẩu mới -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Xác nhận mật khẩu mới"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtForgotConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_input"
            android:hint="Nhập lại mật khẩu mới..."
            android:inputType="textPassword"
            android:paddingHorizontal="14dp"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <!-- Nút Submit -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitForgotPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#2563EB"
            android:text="ĐẶT LẠI MẬT KHẨU"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
